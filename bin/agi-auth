#!/usr/bin/env python3
"""
agi-auth: Simple multi-account manager for Antigravity CLI (agy)
Author: DK625
"""

import sys
import os
import json
import subprocess
import hashlib
import urllib.request
from pathlib import Path

# Ensure UTF-8 output on Windows
if hasattr(sys.stdout, "reconfigure"):
    try:
        sys.stdout.reconfigure(encoding="utf-8")
        sys.stderr.reconfigure(encoding="utf-8")
    except Exception:
        pass

ACCOUNTS_DIR = Path.home() / ".gemini" / "accounts"
QUOTA_CACHE_FILE = Path.home() / ".gemini" / "quota_cache.json"
CRED_TARGET = "gemini:antigravity"
CRED_USER = "antigravity"

if os.name == "nt":
    import ctypes
    from ctypes import wintypes

    class CREDENTIAL(ctypes.Structure):
        _fields_ = [
            ("Flags", wintypes.DWORD),
            ("Type", wintypes.DWORD),
            ("TargetName", wintypes.LPWSTR),
            ("Comment", wintypes.LPWSTR),
            ("LastWritten", wintypes.FILETIME),
            ("CredentialBlobSize", wintypes.DWORD),
            ("CredentialBlob", ctypes.POINTER(ctypes.c_char)),
            ("Persist", wintypes.DWORD),
            ("AttributeCount", wintypes.DWORD),
            ("Attributes", ctypes.c_void_p),
            ("TargetAlias", wintypes.LPWSTR),
            ("UserName", wintypes.LPWSTR),
        ]

    advapi32 = ctypes.WinDLL("advapi32", use_last_error=True)
    PCRED = ctypes.POINTER(CREDENTIAL)
    advapi32.CredReadW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, ctypes.POINTER(PCRED)]
    advapi32.CredWriteW.argtypes = [PCRED, wintypes.DWORD]
    advapi32.CredDeleteW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD]
    advapi32.CredFree.argtypes = [ctypes.c_void_p]
    advapi32.CredFree.restype = None

    def cred_read(target=CRED_TARGET):
        p = PCRED()
        if not advapi32.CredReadW(target, 1, 0, ctypes.byref(p)):
            return None
        try:
            return ctypes.string_at(p.contents.CredentialBlob, p.contents.CredentialBlobSize).decode("utf-8")
        finally:
            advapi32.CredFree(p)

    def cred_write(target=CRED_TARGET, secret="", user=CRED_USER):
        blob = secret.encode("utf-8")
        buf = ctypes.create_string_buffer(blob, len(blob))
        c = CREDENTIAL()
        c.Type = 1
        c.TargetName = target
        c.UserName = user
        c.CredentialBlobSize = len(blob)
        c.CredentialBlob = ctypes.cast(buf, ctypes.POINTER(ctypes.c_char))
        c.Persist = 2
        if not advapi32.CredWriteW(ctypes.byref(c), 0):
            raise OSError(f"CredWriteW failed with error code {ctypes.get_last_error()}")

    def cred_delete(target=CRED_TARGET):
        return bool(advapi32.CredDeleteW(target, 1, 0))

else:
    def cred_read(target=CRED_TARGET):
        if sys.platform == "darwin":
            try:
                res = subprocess.run(
                    ["security", "find-generic-password", "-s", target, "-w"],
                    capture_output=True, text=True, check=True
                )
                return res.stdout.strip()
            except Exception:
                pass
        else:
            try:
                res = subprocess.run(
                    ["secret-tool", "lookup", "service", target],
                    capture_output=True, text=True, check=True
                )
                return res.stdout.strip()
            except Exception:
                pass
        
        fallback_file = Path.home() / ".gemini" / ".active_session.json"
        if fallback_file.exists():
            return fallback_file.read_text(encoding="utf-8")
        return None

    def cred_write(target=CRED_TARGET, secret="", user=CRED_USER):
        if sys.platform == "darwin":
            try:
                subprocess.run(["security", "delete-generic-password", "-s", target], capture_output=True)
                subprocess.run(
                    ["security", "add-generic-password", "-s", target, "-a", user, "-w", secret],
                    capture_output=True, check=True
                )
                return
            except Exception:
                pass
        else:
            try:
                subprocess.run(
                    ["secret-tool", "store", "--label=Antigravity", "service", target, "username", user],
                    input=secret.encode("utf-8"), capture_output=True, check=True
                )
                return
            except Exception:
                pass

        fallback_file = Path.home() / ".gemini" / ".active_session.json"
        fallback_file.parent.mkdir(parents=True, exist_ok=True)
        fallback_file.write_text(secret, encoding="utf-8")

    def cred_delete(target=CRED_TARGET):
        if sys.platform == "darwin":
            res = subprocess.run(["security", "delete-generic-password", "-s", target], capture_output=True)
            return res.returncode == 0
        else:
            res = subprocess.run(["secret-tool", "clear", "service", target], capture_output=True)
            if res.returncode == 0:
                return True
        fallback_file = Path.home() / ".gemini" / ".active_session.json"
        if fallback_file.exists():
            fallback_file.unlink()
            return True
        return False


def get_token_key(json_str):
    if not json_str:
        return None
    try:
        data = json.loads(json_str)
        return data.get("token", {}).get("refresh_token") or hashlib.sha256(json_str.encode()).hexdigest()
    except Exception:
        return json_str.strip()


def fetch_account_email(access_token):
    """Fetch email from Google OAuth userinfo API."""
    if not access_token:
        return None
    try:
        req = urllib.request.Request(
            "https://www.googleapis.com/oauth2/v3/userinfo",
            headers={"Authorization": f"Bearer {access_token}"}
        )
        with urllib.request.urlopen(req, timeout=3) as resp:
            data = json.loads(resp.read().decode())
            return data.get("email")
    except Exception:
        return None


def get_cached_quota():
    """Load quota cached by statusline or CLI."""
    if QUOTA_CACHE_FILE.exists():
        try:
            return json.loads(QUOTA_CACHE_FILE.read_text(encoding="utf-8"))
        except Exception:
            return None
    return None


def format_quota(q_data):
    """Format remaining fraction and reset time into human-readable string."""
    if not q_data:
        return "100%"
    rem = q_data.get("remaining_fraction")
    if rem is None:
        return "100%"
    pct = int(round(float(rem) * 100))
    res = q_data.get("reset_time")
    time_str = ""
    if res and res != "null":
        try:
            # ISO timestamp -> hour:minute
            time_str = f" (reset {res.split('T')[1][:5]})"
        except Exception:
            pass
    return f"{pct}%{time_str}"


def cmd_list():
    """List all saved accounts with Email & Quotas."""
    ACCOUNTS_DIR.mkdir(parents=True, exist_ok=True)
    saved_files = sorted(ACCOUNTS_DIR.glob("*.json"))
    curr_raw = cred_read()
    curr_key = get_token_key(curr_raw)
    quota_info = get_cached_quota()

    print("\033[1;36m=== Antigravity Accounts ===\033[0m")

    has_active_match = False
    if saved_files:
        for f in saved_files:
            acc_name = f.stem
            try:
                content = f.read_text(encoding="utf-8")
                acc_obj = json.loads(content)
                saved_key = get_token_key(content)
                is_active = (curr_key and saved_key == curr_key)
                if is_active:
                    has_active_match = True

                # Get email
                email = acc_obj.get("email")
                if not email:
                    token = acc_obj.get("token", {}).get("access_token")
                    email = fetch_account_email(token)
                    if email:
                        acc_obj["email"] = email
                        f.write_text(json.dumps(acc_obj, indent=2), encoding="utf-8")

                email_display = f"({email})" if email else "(No email)"
                status_tag = "\033[1;32m● active\033[0m" if is_active else "\033[90m○ inactive\033[0m"
                marker = "\033[1;32m*\033[0m" if is_active else " "

                print(f" {marker} \033[1m{acc_name}\033[0m \033[36m{email_display}\033[0m [{status_tag}]")

                # Show quota info for active account or from cached profile
                q_5h = "100%"
                q_7d = "100%"
                tier_str = "Standard"

                if is_active and quota_info:
                    tier_str = quota_info.get("plan_tier") or "Standard"
                    q_obj = quota_info.get("quota") or {}
                    q_5h = format_quota(q_obj.get("gemini-5h"))
                    q_7d = format_quota(q_obj.get("gemini-weekly"))
                elif "quota" in acc_obj:
                    q_5h = format_quota(acc_obj.get("quota", {}).get("gemini-5h"))
                    q_7d = format_quota(acc_obj.get("quota", {}).get("gemini-weekly"))
                    tier_str = acc_obj.get("plan_tier", "Standard")

                print(f"    \033[90m├─ 5h Limit:     \033[0m\033[33m{q_5h}\033[0m")
                print(f"    \033[90m├─ Weekly Limit: \033[0m\033[33m{q_7d}\033[0m")
                print(f"    \033[90m└─ Plan / Tier:  \033[0m\033[37m{tier_str}\033[0m")
                print()

            except Exception as e:
                print(f"    {acc_name} (corrupt: {e})")

    if curr_raw and not has_active_match:
        print("  \033[1;33m* (current live session - unsaved)\033[0m")
        print("\033[90m  -> Run 'agi-auth login <name>' to save this account.\033[0m\n")
    elif not saved_files and not curr_raw:
        print("\033[93m[!] No saved accounts. Run 'agi-auth login <name>' to login.\033[0m\n")


def cmd_login(name=None):
    """Log in / register an account."""
    if not name:
        if len(sys.argv) > 2:
            name = sys.argv[2]
        else:
            try:
                name = input("Enter account name (e.g. acc1, acc2): ").strip()
            except (KeyboardInterrupt, EOFError):
                print("\nAborted.")
                sys.exit(0)

    if not name:
        print("\033[91m[Error] Account name cannot be empty.\033[0m")
        sys.exit(1)

    ACCOUNTS_DIR.mkdir(parents=True, exist_ok=True)
    target_file = ACCOUNTS_DIR / f"{name}.json"

    curr_raw = cred_read()
    curr_key = get_token_key(curr_raw)

    saved_files = sorted(ACCOUNTS_DIR.glob("*.json"))
    has_active_match = False
    for f in saved_files:
        try:
            if get_token_key(f.read_text(encoding="utf-8")) == curr_key:
                has_active_match = True
                break
        except Exception:
            pass

    force_new = "--new" in sys.argv or "--force" in sys.argv

    # If current live session is not saved yet, save it directly under this name!
    if curr_raw and not has_active_match and not force_new:
        try:
            acc_obj = json.loads(curr_raw)
        except Exception:
            acc_obj = {"token": curr_raw}
        token = acc_obj.get("token", {}).get("access_token")
        email = fetch_account_email(token)
        if email:
            acc_obj["email"] = email
        target_file.write_text(json.dumps(acc_obj, indent=2), encoding="utf-8")
        email_txt = f" ({email})" if email else ""
        print(f"\033[1;32m[OK] Linked current active session as '{name}'{email_txt}!\033[0m")
        print("\033[90m(To login with a different Google account instead, run: agi-auth login <name> --new)\033[0m")
        return

    # Clear active session and open agy for OAuth login
    cred_delete(CRED_TARGET)
    print(f"\033[1;36m[>] Starting Antigravity CLI to authenticate account '{name}'...\033[0m")
    print("\033[90mPlease complete login in your browser if prompted.\033[0m")

    try:
        subprocess.run(["agy"], check=False)
    except FileNotFoundError:
        print("\033[91m[Error] 'agy' command not found in PATH!\033[0m")
        sys.exit(1)

    new_cred = cred_read(CRED_TARGET)
    if new_cred:
        try:
            acc_obj = json.loads(new_cred)
        except Exception:
            acc_obj = {"token": new_cred}
        token = acc_obj.get("token", {}).get("access_token")
        email = fetch_account_email(token)
        if email:
            acc_obj["email"] = email
        target_file.write_text(json.dumps(acc_obj, indent=2), encoding="utf-8")
        email_txt = f" ({email})" if email else ""
        print(f"\033[1;32m[OK] Login successful! Saved account as '{name}'{email_txt}.\033[0m")
    else:
        print("\033[91m[Error] No new credential detected after login.\033[0m")


def cmd_switch(name):
    """Switch to a saved account."""
    if not name:
        print("\033[91m[Error] Missing account name. Usage: agi-auth switch <name>\033[0m")
        sys.exit(1)

    target_file = ACCOUNTS_DIR / f"{name}.json"
    if not target_file.exists():
        print(f"\033[91m[Error] Account '{name}' not found!\033[0m")
        cmd_list()
        sys.exit(1)

    acc_obj = json.loads(target_file.read_text(encoding="utf-8"))
    # Save back credential blob
    secret_str = json.dumps(acc_obj) if "token" in acc_obj else target_file.read_text(encoding="utf-8")
    cred_write(CRED_TARGET, secret_str, CRED_USER)
    email_txt = f" ({acc_obj.get('email')})" if acc_obj.get("email") else ""
    print(f"\033[1;32m[OK] Switched to account '{name}'{email_txt} successfully!\033[0m")


def cmd_remove(name):
    """Remove a saved account."""
    if not name:
        print("\033[91m[Error] Missing account name. Usage: agi-auth remove <name>\033[0m")
        sys.exit(1)

    target_file = ACCOUNTS_DIR / f"{name}.json"
    if target_file.exists():
        target_file.unlink()
        print(f"\033[1;32m[OK] Removed account '{name}'.\033[0m")
    else:
        print(f"\033[93m[!] Account '{name}' does not exist.\033[0m")


def print_help():
    print("""\033[1;36magi-auth\033[0m - Multi-account manager for Antigravity CLI (agy)

\033[1mUsage:\033[0m
  agi-auth login <name>     Đăng nhập / Đăng ký tài khoản <name>
  agi-auth list             Xem danh sách tài khoản, Email & Quota (5h/weekly)
  agi-auth switch <name>    Chuyển sang tài khoản <name>
  agi-auth remove <name>    Xóa tài khoản <name>

\033[1mQuick Run:\033[0m
  agi                       Chạy agy với --dangerously-skip-permissions
""")


def main():
    if len(sys.argv) < 2:
        print_help()
        return

    action = sys.argv[1].lower()
    arg = sys.argv[2] if len(sys.argv) > 2 else None

    if action in ("login", "signin"):
        cmd_login(arg)
    elif action in ("list", "ls"):
        cmd_list()
    elif action in ("switch", "use"):
        cmd_switch(arg)
    elif action in ("remove", "rm", "delete"):
        cmd_remove(arg)
    elif action in ("help", "--help", "-h"):
        print_help()
    else:
        print(f"\033[91mUnknown command: {action}\033[0m\n")
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
