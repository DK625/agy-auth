SUCCESS_HTML = base64.b64decode("").decode("utf-8")

if os.name == "nt":
    import ctypes
    from ctypes import wintypes

    class CREDENTIAL(ctypes.Structure):
        _fields_ = [
            ("Flags", wintypes.DWORD),
            ("Type", wintypes.DWORD),
            ("TargetName", wintypes.LPWSTR),
            ("Comment", wintypes.LPWSTR),
            ("LastWritten", wintypes.FILETIME),
            ("CredentialBlobSize", wintypes.DWORD),
            ("CredentialBlob", ctypes.POINTER(ctypes.c_char)),
            ("Persist", wintypes.DWORD),
            ("AttributeCount", wintypes.DWORD),
            ("Attributes", ctypes.c_void_p),
            ("TargetAlias", wintypes.LPWSTR),
            ("UserName", wintypes.LPWSTR),
        ]

    advapi32 = ctypes.WinDLL("advapi32", use_last_error=True)
    PCRED = ctypes.POINTER(CREDENTIAL)
    advapi32.CredReadW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, ctypes.POINTER(PCRED)]
    advapi32.CredWriteW.argtypes = [PCRED, wintypes.DWORD]
    advapi32.CredDeleteW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD]
    advapi32.CredFree.argtypes = [ctypes.c_void_p]
    advapi32.CredFree.restype = None

    def cred_read(target=CRED_TARGET):
        p = PCRED()
        if not advapi32.CredReadW(target, 1, 0, ctypes.byref(p)):
            return None
        try:
            return ctypes.string_at(p.contents.CredentialBlob, p.contents.CredentialBlobSize).decode("utf-8")
        finally:
            advapi32.CredFree(p)

    def cred_write(target=CRED_TARGET, secret="", user=CRED_USER):
        blob = secret.encode("utf-8")
        buf = ctypes.create_string_buffer(blob, len(blob))
        c = CREDENTIAL()
        c.Type = 1
        c.TargetName = target
        c.UserName = user
        c.CredentialBlobSize = len(blob)
        c.CredentialBlob = ctypes.cast(buf, ctypes.POINTER(ctypes.c_char))
        c.Persist = 2
        if not advapi32.CredWriteW(ctypes.byref(c), 0):
            raise OSError(f"CredWriteW failed with error code {ctypes.get_last_error()}")

    def cred_delete(target=CRED_TARGET):
        return bool(advapi32.CredDeleteW(target, 1, 0))

else:
    def cred_read(target=CRED_TARGET):
        if sys.platform == "darwin":
            try:
                res = subprocess.run(
                    ["security", "find-generic-password", "-s", target, "-w"],
                    capture_output=True, text=True, check=True
                )
                return res.stdout.strip()
            except Exception:
                pass
        else:
            try:
                res = subprocess.run(
                    ["secret-tool", "lookup", "service", target],
                    capture_output=True, text=True, check=True
                )
                return res.stdout.strip()
            except Exception:
                pass
        
        fallback_file = Path.home() / ".gemini" / ".active_session.json"
        if fallback_file.exists():
            return fallback_file.read_text(encoding="utf-8")
        return None

    def cred_write(target=CRED_TARGET, secret="", user=CRED_USER):
        if sys.platform == "darwin":
            try:
                subprocess.run(["security", "delete-generic-password", "-s", target], capture_output=True)
                subprocess.run(
                    ["security", "add-generic-password", "-s", target, "-a", user, "-w", secret],
                    capture_output=True, check=True
                )
                return
            except Exception:
                pass
        else:
            try:
                subprocess.run(
                    ["secret-tool", "store", "--label=Antigravity", "service", target, "username", user],
                    input=secret.encode("utf-8"), capture_output=True, check=True
                )
                return
            except Exception:
                pass

        fallback_file = Path.home() / ".gemini" / ".active_session.json"
        fallback_file.parent.mkdir(parents=True, exist_ok=True)
        fallback_file.write_text(secret, encoding="utf-8")

    def cred_delete(target=CRED_TARGET):
        if sys.platform == "darwin":
            res = subprocess.run(["security", "delete-generic-password", "-s", target], capture_output=True)
            return res.returncode == 0
        else:
            res = subprocess.run(["secret-tool", "clear", "service", target], capture_output=True)
            if res.returncode == 0:
                return True
        fallback_file = Path.home() / ".gemini" / ".active_session.json"
        if fallback_file.exists():
            fallback_file.unlink()
            return True
        return False


def get_token_key(json_str):
    if not json_str:
        return None
    try:
        data = json.loads(json_str)
        return data.get("token", {}).get("refresh_token") or hashlib.sha256(json_str.encode()).hexdigest()
    except Exception:
        return json_str.strip()


def parse_iso_dt(iso_str):
    """Safely parse ISO datetime string with arbitrary fractional seconds."""
    if not iso_str or iso_str == "null":
        return None
    try:
        clean = iso_str.replace("Z", "+00:00")
        if "." in clean:
            base, rest = clean.split(".", 1)
            tz_idx = max(rest.find("+"), rest.find("-"))
            if tz_idx != -1:
                frac = rest[:tz_idx][:6]
                tz = rest[tz_idx:]
                clean = f"{base}.{frac}{tz}"
            else:
                frac = rest[:6]
                clean = f"{base}.{frac}"
        return datetime.fromisoformat(clean)
    except Exception:
        return None


def ensure_valid_token(acc_obj, account_file=None):
    """Ensure account has a fresh access_token, refreshing automatically if expired."""
    token_data = acc_obj.get("token", {})
    access_token = token_data.get("access_token")
    refresh_token = token_data.get("refresh_token")
    expiry = token_data.get("expiry")

    is_expired = True
    if expiry:
        exp_dt = parse_iso_dt(expiry)
        if exp_dt:
            if exp_dt.tzinfo is None:
                exp_dt = exp_dt.replace(tzinfo=timezone.utc)
            if exp_dt > datetime.now(timezone.utc) + timedelta(minutes=2):
                is_expired = False

    if not is_expired and access_token:
        return access_token

    if not refresh_token:
        return access_token

    for cfg in CLIENT_CONFIGS:
        token_url = "https://oauth2.googleapis.com/token"
        payload = urllib.parse.urlencode({
            "client_id": cfg["id"],
            "client_secret": cfg["secret"],
            "grant_type": "refresh_token",
            "refresh_token": refresh_token
        }).encode("utf-8")

        try:
            req = urllib.request.Request(
                token_url,
                data=payload,
                headers={"Content-Type": "application/x-www-form-urlencoded", "User-Agent": "Mozilla/5.0"}
            )
            with urllib.request.urlopen(req, timeout=5) as resp:
                new_token_data = json.loads(resp.read().decode("utf-8"))
                new_access_token = new_token_data.get("access_token")
                expires_in = new_token_data.get("expires_in", 3600)
                exp_dt = datetime.now(timezone.utc) + timedelta(seconds=expires_in)
                
                token_data["access_token"] = new_access_token
                token_data["expiry"] = exp_dt.isoformat()
                acc_obj["token"] = token_data
                
                if account_file and account_file.exists():
                    account_file.write_text(json.dumps(acc_obj, indent=2), encoding="utf-8")

                curr_raw = cred_read()
                if curr_raw and get_token_key(curr_raw) == refresh_token:
                    cred_write(CRED_TARGET, json.dumps(acc_obj), CRED_USER)

                return new_access_token
        except Exception:
            continue

    return access_token


def fetch_account_email(access_token):
    """Fetch email from Google OAuth userinfo API."""
    if not access_token:
        return None
    try:
        req = urllib.request.Request(
            "https://www.googleapis.com/oauth2/v3/userinfo",
            headers={"Authorization": f"Bearer {access_token}"}
        )
        with urllib.request.urlopen(req, timeout=3) as resp:
            data = json.loads(resp.read().decode())
            return data.get("email")
    except Exception:
        return None


def get_cached_quota():
    """Load live quota cached from statusline/agy."""
    if QUOTA_CACHE_FILE.exists():
        try:
            return json.loads(QUOTA_CACHE_FILE.read_text(encoding="utf-8-sig"))
        except Exception:
            return None
    return None


def format_relative_time(mtime, is_active=False):
    """Format file mtime to relative time string (Now, 1d ago, etc.)."""
    if is_active:
        return "Now"
    now = datetime.now()
    diff = now - datetime.fromtimestamp(mtime)
    secs = int(diff.total_seconds())
    if secs < 120:
        return "Now"
    mins = secs // 60
    if mins < 60:
        return f"{mins}m ago"
    hours = mins // 60
    if hours < 24:
        return f"{hours}h ago"
    days = hours // 24
    return f"{days}d ago"


def format_usage_dt(q_data, is_5h=False):
    """Calculate REMAINING quota percentage and dynamically handle reset time."""
    if not q_data:
        return "-"
    rem = q_data.get("remaining_fraction")
    if rem is None:
        return "-"
    remain_pct = int(round(float(rem) * 100))
    
    res = q_data.get("reset_time")
    if res:
        dt = parse_iso_dt(res)
        if dt:
            local_dt = dt.astimezone()
            now = datetime.now(timezone.utc).astimezone()
            if local_dt <= now:
                return "100%"
            if is_5h:
                time_str = local_dt.strftime("%H:%M")
            else:
                time_str = local_dt.strftime("%H:%M, %d %b")
            return f"{remain_pct}% ({time_str})"
    return f"{remain_pct}%"


def launch_agi(account_email=None, extra_args=None):
    """Launch Antigravity CLI directly (agy --dangerously-skip-permissions)."""
    print("\n\x1b[1;36m[>] Launching Antigravity CLI (agi)...\x1b[0m\n")
    if account_email:
        os.environ["AGI_ACTIVE_ACCOUNT"] = account_email
    cmd = ["agy", "--dangerously-skip-permissions"]
    if extra_args:
        cmd.extend(extra_args)
    try:
        if sys.platform == "win32":
            subprocess.call(" ".join(cmd), shell=True)
        else:
            subprocess.call(cmd)
    except KeyboardInterrupt:
        pass
    except Exception as e:
        print(f"\x1b[91m[!] Could not launch agi automatically: {e}\x1b[0m")
        print("You can run 'agi' manually.")


def sync_active_session():
    """Auto-detect and import/sync active session from OS Credential Vault into ~/.gemini/accounts/."""
    try:
        curr_raw = cred_read()
        if not curr_raw:
            return None

        curr_obj = json.loads(curr_raw)
        tok_data = curr_obj.get("token")
        if not tok_data or not isinstance(tok_data, dict):
            return None

        curr_key = get_token_key(curr_raw)
        ACCOUNTS_DIR.mkdir(parents=True, exist_ok=True)
        saved_files = sorted(ACCOUNTS_DIR.glob("*.json"))

        matched_file = None
        for f in saved_files:
            try:
                f_content = f.read_text(encoding="utf-8")
                f_obj = json.loads(f_content)
                f_key = get_token_key(f_content)
                if curr_key and f_key == curr_key:
                    matched_file = f
                    break
            except Exception:
                pass

        if matched_file:
            return matched_file

        email = curr_obj.get("email")
        if not email:
            email = fetch_account_email(tok_data.get("access_token"))

        if not email:
            return None

        clean_name = re.sub(r'[/\\:*?"<>|]', '_', email)
        target_file = ACCOUNTS_DIR / f"{clean_name}.json"
        
        curr_obj["email"] = email
        if "auth_method" not in curr_obj:
            curr_obj["auth_method"] = "consumer"
            
        target_file.write_text(json.dumps(curr_obj, indent=2), encoding="utf-8")
        return target_file
    except Exception:
        return None


def find_account_file(identifier):
    """Find account JSON file by index number, alias name, or email string."""
    ACCOUNTS_DIR.mkdir(parents=True, exist_ok=True)
    saved_files = sorted(ACCOUNTS_DIR.glob("*.json"))
    if not saved_files:
        return None

    if str(identifier).isdigit():
        idx = int(identifier) - 1
        if 0 <= idx < len(saved_files):
            return saved_files[idx]
        return None

    clean_id = re.sub(r'[/\\:*?"<>|]', '_', str(identifier).strip())
    direct = ACCOUNTS_DIR / f"{clean_id}.json"
    if direct.exists():
        return direct
    
    if (ACCOUNTS_DIR / identifier).exists():
        return ACCOUNTS_DIR / identifier

    for f in saved_files:
        try:
            obj = json.loads(f.read_text(encoding="utf-8"))
            if obj.get("email", "").lower() == str(identifier).strip().lower():
                return f
        except Exception:
            pass
    return None


def extract_quota_strings(q_obj):
    if not q_obj or not isinstance(q_obj, dict):
        return "-", "-"
    q_5h_data = q_obj.get("gemini-5h") or q_obj.get("3p-5h")
    q_wk_data = q_obj.get("gemini-weekly") or q_obj.get("3p-weekly")
    q_5h = format_usage_dt(q_5h_data, is_5h=True) if q_5h_data else "-"
    q_wk = format_usage_dt(q_wk_data, is_5h=False) if q_wk_data else "-"
    return q_5h, q_wk


def cmd_list():
    """List all saved accounts with their isolated 5H and Weekly quota."""
    sync_active_session()
    ACCOUNTS_DIR.mkdir(parents=True, exist_ok=True)
    saved_files = sorted(ACCOUNTS_DIR.glob("*.json"))
    curr_raw = cred_read()
    curr_key = get_token_key(curr_raw)

    h_acc = "ACCOUNT"
    h_plan = "PLAN"
    h_5h = "5H REMAIN"
    h_wk = "WEEKLY REMAIN"
    h_act = "LAST ACTIVITY"
    header = f"     {h_acc:<28} {h_plan:<14} {h_5h:<15} {h_wk:<20} {h_act:<13}"
    print(header)
    print("-" * len(header))

    if not saved_files and not curr_raw:
        print("  -- No accounts saved yet. Run 'agi-auth login' to add an account. --")
        return

    has_active_match = False

    for idx, f in enumerate(saved_files, 1):
        try:
            content = f.read_text(encoding="utf-8")
            acc_obj = json.loads(content)
            saved_key = get_token_key(content)
            is_active = bool(curr_key and saved_key == curr_key)
            email = acc_obj.get("email") or f.stem

            if is_active:
                has_active_match = True

            # Always sync active token from Credential Vault if currently active
            if is_active and curr_raw:
                try:
                    curr_obj = json.loads(curr_raw)
                    vault_tok = curr_obj.get("token")
                    if vault_tok and vault_tok.get("access_token") != acc_obj.get("token", {}).get("access_token"):
                        acc_obj["token"] = vault_tok
                        f.write_text(json.dumps(acc_obj, indent=2), encoding="utf-8")
                except Exception:
                    pass

            plan = acc_obj.get("plan_tier", "Standard")
            error = acc_obj.get("error")
            q_5h = "-"
            q_wk = "-"

            if error:
                err_str = str(error)
                plan = "Error / Verify"
                q_5h = err_str if len(err_str) <= 15 else (err_str[:12] + "...")
                q_wk = "Need Verify"
            elif "quota" in acc_obj:
                saved_q = acc_obj.get("quota") or {}
                q_5h, q_wk = extract_quota_strings(saved_q)

            mtime = f.stat().st_mtime
            rel_time = format_relative_time(mtime, is_active=is_active)
            
            marker = "* " if is_active else "  "
            idx_str = f"{idx:02d}"
            disp_col = email if len(email) <= 28 else (email[:25] + "...")

            if is_active:
                print(f"\x1b[1;32m{marker}{idx_str} {disp_col:<28} {plan:<14} {q_5h:<15} {q_wk:<20} {rel_time:<13}\x1b[0m")
            else:
                print(f"{marker}{idx_str} {disp_col:<28} {plan:<14} {q_5h:<15} {q_wk:<20} {rel_time:<13}")
        except Exception:
            pass

    if curr_raw and not has_active_match:
        curr_token = None
        try:
            curr_token = json.loads(curr_raw).get("token", {}).get("access_token")
        except Exception:
            pass
        curr_email = fetch_account_email(curr_token) or "current session"
        print(f"\x1b[1;33m* ?? {curr_email:<28} [unsaved] Run 'agi-auth login' to save\x1b[0m")


OAUTH_PRIMARY_CLIENT = CLIENT_CONFIGS[1]

OAUTH_SCOPES = [
    "https://www.googleapis.com/auth/cloud-platform",
    "https://www.googleapis.com/auth/userinfo.email",
    "https://www.googleapis.com/auth/userinfo.profile",
    "https://www.googleapis.com/auth/cclog",
    "https://www.googleapis.com/auth/experimentsandconfigs",
    "https://www.googleapis.com/auth/aicode",
    "openid"
]

REDIRECT_URI = "https://antigravity.google/oauth-callback"


def perform_direct_google_oauth(name=None):
    """Direct Google OAuth PKCE flow using official Antigravity endpoint."""
    verifier = secrets.token_urlsafe(64)
    digest = hashlib.sha256(verifier.encode("ascii")).digest()
    challenge = base64.urlsafe_b64encode(digest).rstrip(b"=").decode("ascii")
    state = secrets.token_urlsafe(32)

    auth_params = {
        "access_type": "offline",
        "client_id": OAUTH_PRIMARY_CLIENT["id"],
        "code_challenge": challenge,
        "code_challenge_method": "S256",
        "prompt": "consent",
        "redirect_uri": REDIRECT_URI,
        "response_type": "code",
        "scope": " ".join(OAUTH_SCOPES),
        "state": state
    }
    auth_url = "https://accounts.google.com/o/oauth2/auth?" + urllib.parse.urlencode(auth_params)

    print("\n\x1b[1;36m[>] Opening Google OAuth in your browser...\x1b[0m")
    print(f"\x1b[90mIf your browser does not open automatically, copy and open this URL:\x1b[0m\n\x1b[4;34m{auth_url}\x1b[0m\n")

    try:
        webbrowser.open(auth_url)
    except Exception:
        pass

    print("\x1b[93mAfter completing login in your browser, copy the authorization code.\x1b[0m")
    raw_code = input("\x1b[1;32mPaste authorization code (or URL) here: \x1b[0m").strip()
    if not raw_code:
        print("\x1b[91m[Error] No authorization code provided.\x1b[0m")
        return False

    code = raw_code
    if ("code=" in code or "http" in code) and ("?" in code or "&" in code):
        try:
            parsed = urllib.parse.urlparse(code)
            qs = urllib.parse.parse_qs(parsed.query)
            if "code" in qs:
                code = qs["code"][0]
        except Exception:
            pass

    token_url = "https://oauth2.googleapis.com/token"
    token_payload = urllib.parse.urlencode({
        "client_id": OAUTH_PRIMARY_CLIENT["id"],
        "client_secret": OAUTH_PRIMARY_CLIENT["secret"],
        "grant_type": "authorization_code",
        "code": code,
        "redirect_uri": REDIRECT_URI,
        "code_verifier": verifier
    }).encode("utf-8")

    try:
        token_req = urllib.request.Request(
            token_url,
            data=token_payload,
            headers={
                "Content-Type": "application/x-www-form-urlencoded",
                "User-Agent": "Mozilla/5.0"
            }
        )
        with urllib.request.urlopen(token_req, timeout=15) as resp:
            token_res = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        err_msg = e.read().decode("utf-8", errors="ignore")
        print(f"\x1b[91m[Error] Token exchange failed: {e.code} - {err_msg}\x1b[0m")
        return False
    except Exception as e:
        print(f"\x1b[91m[Error] Token exchange failed: {e}\x1b[0m")
        return False

    access_token = token_res.get("access_token")
    refresh_token = token_res.get("refresh_token")
    expires_in = token_res.get("expires_in", 3600)
    expiry_dt = datetime.now(timezone.utc) + timedelta(seconds=expires_in)
    expiry_iso = expiry_dt.isoformat()

    email = fetch_account_email(access_token)

    agy_credential_obj = {
        "auth_method": "consumer",
        "token": {
            "access_token": access_token,
            "token_type": "Bearer",
            "refresh_token": refresh_token,
            "expiry": expiry_iso
        }
    }
    if email:
        agy_credential_obj["email"] = email

    cred_json_str = json.dumps(agy_credential_obj)
    cred_write(CRED_TARGET, cred_json_str, CRED_USER)

    profile_name = name if name else (email if email else f"account_{int(time.time())}")
    ACCOUNTS_DIR.mkdir(parents=True, exist_ok=True)
    target_file = ACCOUNTS_DIR / f"{profile_name}.json"
    target_file.write_text(json.dumps(agy_credential_obj, indent=2), encoding="utf-8")

    print(f"\n\x1b[1;32m[OK] Login successful! Saved account as '{profile_name}'.\x1b[0m")
    return email if email else True


def cmd_login(name=None, launch=True):
    """Directly triggers Google OAuth login, saves account, and launches agi."""
    res = perform_direct_google_oauth(name)
    if res and launch:
        email = res if isinstance(res, str) else None
        launch_agi(account_email=email)


def cmd_switch(identifier, launch=True):
    """Switch to a saved account (by index, alias, or email) and launch agi."""
    if not identifier:
        print("\x1b[91m[Error] Missing account name or email. Usage: agi-auth switch <number_or_email>\x1b[0m")
        sys.exit(1)

    sync_active_session()
    target_file = find_account_file(identifier)
    if not target_file:
        print(f"\x1b[91m[Error] Account or email '{identifier}' not found!\x1b[0m")
        cmd_list()
        sys.exit(1)

    acc_obj = json.loads(target_file.read_text(encoding="utf-8"))
    ensure_valid_token(acc_obj, target_file)

    secret_str = json.dumps(acc_obj) if "token" in acc_obj else target_file.read_text(encoding="utf-8")
    cred_write(CRED_TARGET, secret_str, CRED_USER)

    try:
        if QUOTA_CACHE_FILE.exists():
            QUOTA_CACHE_FILE.unlink()
    except Exception:
        pass
    
    email = acc_obj.get("email")
    display_txt = email if email else target_file.stem
    print(f"\x1b[1;32m[OK] Switched to account '{display_txt}' successfully!\x1b[0m")
    if launch:
        launch_agi(account_email=email)


def cmd_remove(identifier):
    """Remove a saved account (by index, alias, or email)."""
    if not identifier:
        print("\x1b[91m[Error] Missing account name or email. Usage: agi-auth remove <number_or_email>\x1b[0m")
        sys.exit(1)

    sync_active_session()
    target_file = find_account_file(identifier)
    if target_file and target_file.exists():
        target_file.unlink()
        print(f"\x1b[1;32m[OK] Removed account '{target_file.stem}'.\x1b[0m")
    else:
        print(f"\x1b[93m[!] Account '{identifier}' does not exist.\x1b[0m")


def cmd_sync():
    """Explicitly sync/import active Antigravity session into saved accounts."""
    saved_file = sync_active_session()
    if saved_file:
        try:
            obj = json.loads(saved_file.read_text(encoding="utf-8"))
            em = obj.get("email", saved_file.stem)
            print(f"\x1b[1;32m[OK] Synced active session for '{em}'.\x1b[0m")
        except Exception:
            print(f"\x1b[1;32m[OK] Synced active session ({saved_file.stem}).\x1b[0m")
    else:
        print("\x1b[93m[!] No active Antigravity session found in vault to sync.\x1b[0m")


def cmd_notify(bot_token=None, chat_id=None):
    """View or configure Telegram notification credentials."""
    notify_json_path = Path.home() / ".gemini" / "notify.json"

    if bot_token and chat_id:
        cfg = {"telegram_bot_token": bot_token, "telegram_chat_id": chat_id}
        notify_json_path.parent.mkdir(parents=True, exist_ok=True)
        notify_json_path.write_text(json.dumps(cfg, indent=2), encoding="utf-8")
        print("\x1b[1;32m[OK] Telegram notification credentials saved successfully to ~/.gemini/notify.json!\x1b[0m")
    else:
        print("\x1b[1;36m=== Telegram Notification Config ===\x1b[0m")
        if notify_json_path.exists():
            try:
                cfg = json.loads(notify_json_path.read_text(encoding="utf-8"))
                token = cfg.get("telegram_bot_token", "")
                cid = cfg.get("telegram_chat_id", "")
                masked_token = (token[:6] + "..." + token[-4:]) if len(token) > 10 else ("Configured" if token else "Not set")
                print(f"  Bot Token: {masked_token}")
                print(f"  Chat ID:   {cid if cid else 'Not set'}")
            except Exception as e:
                print(f"  Error reading config: {e}")
        else:
            print("  Status: Not configured yet")

        print("\n\x1b[1mTo configure Telegram notifications, run:\x1b[0m")
        print("  agi-auth notify <bot_token> <chat_id>\n")


def print_help():
    print("""\x1b[1;36magi-auth\x1b[0m - Multi-account manager for Antigravity CLI (agy)

\x1b[1mUsage:\x1b[0m
  agi-auth login [name]        Đăng nhập Google OAuth (Tự động lưu & mở agi)
  agi-auth list                Xem danh sách tài khoản, Email, Plan & Quota
  agi-auth switch <num/email>  Chuyển sang tài khoản & mở agi
  agi-auth remove <num/email>  Xóa tài khoản (bằng Số thứ tự hoặc Email)
  agi-auth sync                Tự động đồng bộ tài khoản đang đăng nhập hiện tại
  agi-auth notify [token] [id] Cấu hình Telegram notification (bot_token & chat_id)

\x1b[1mOptions:\x1b[0m
  --no-launch, -n              Chuyển/đăng nhập mà không tự khởi chạy agi

\x1b[1mQuick Run:\x1b[0m
  agi                          Chạy agy với --dangerously-skip-permissions
""")


def main():
    if len(sys.argv) < 2:
        print_help()
        return

    action = sys.argv[1].lower()
    no_launch = any(arg in sys.argv for arg in ("--no-launch", "-n", "--no-start"))
    args_clean = [a for a in sys.argv[2:] if a not in ("--no-launch", "-n", "--no-start")]
    arg1 = args_clean[0] if len(args_clean) > 0 else None
    arg2 = args_clean[1] if len(args_clean) > 1 else None

    if action in ("login", "signin"):
        cmd_login(arg1, launch=not no_launch)
    elif action in ("list", "ls"):
        cmd_list()
    elif action in ("switch", "use"):
        cmd_switch(arg1, launch=not no_launch)
    elif action in ("remove", "rm", "delete"):
        cmd_remove(arg1)
    elif action in ("sync", "import"):
        cmd_sync()
    elif action in ("notify", "telegram"):
        cmd_notify(arg1, arg2)
    elif action in ("help", "--help", "-h"):
        print_help()
    else:
        print(f"\x1b[91mUnknown command: {action}\x1b[0m\n")
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()

